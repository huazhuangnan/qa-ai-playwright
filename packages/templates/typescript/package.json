{
  "name": "qa-typescript",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "check:lock": "bun scripts/check_lock.ts",
    "test": "playwright test",
    "test:api": "playwright test tests/api --project=chromium",
    "test:contract": "playwright test tests/api --project=chromium --grep @contract",
    "test:unit": "playwright test tests/unit --project=chromium",
    "test:functional": "playwright test tests/functional --project=chromium",
    "test:smoke": "playwright test --grep @smoke --project=chromium",
    "test:regression": "playwright test --grep @regression --project=chromium",
    "test:integration": "playwright test tests/api --grep @integration --project=chromium",
    "test:e2e": "playwright test tests/e2e --project=chromium",
    "auth:setup": "playwright test --project=auth-setup",
    "report": "playwright show-report",
    "typecheck": "bunx tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "24.0.0",
    "dotenv": "17.2.3",
    "typescript": "5.9.3"
  }
}
