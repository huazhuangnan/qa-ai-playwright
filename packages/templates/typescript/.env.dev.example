# 本地 dev 示例。复制为 .env.dev，不提交真实值。
# 以下字段是基础适配，不是完整变量清单。
UI_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000
# BASE_URL 仅作为旧配置兼容回退。
# PLAYWRIGHT_WEB_SERVER_COMMAND=pnpm run start
# QA_API_TOKEN=
# QA_API_TOKEN_HEADER=Authorization
# QA_API_AUTH_SCHEME=Bearer
# QA_API_TIMEOUT=15
# 设置角色列表后启用 auth-setup；也可用 QA_AUTH_STATE 直接读取单个手工状态文件。
# QA_AUTH_ROLES=admin,user
# QA_AUTH_ROLE=admin
# QA_AUTH_STATE=playwright/.auth/manual.json
# QA_AUTH_LOGIN_PATH=/login
# QA_AUTH_USERNAME_SELECTOR=input[name="username"]
# QA_AUTH_PASSWORD_SELECTOR=input[name="password"]
# QA_AUTH_SUBMIT_SELECTOR=button[type="submit"]
# QA_AUTH_SUCCESS_SELECTOR=[data-testid="account-menu"]
# QA_AUTH_SUCCESS_URL=**/home
# QA_AUTH_INDEXED_DB=false
# QA_AUTH_ADMIN_USERNAME=
# QA_AUTH_ADMIN_PASSWORD=
# QA_AUTH_USER_USERNAME=
# QA_AUTH_USER_PASSWORD=
# QA_ALLOW_PRODUCTION_WRITES=false
# REQUIRE_API_TESTS=0
#
# 按接口契约在代码与工作流中增加项目变量。
# 常见类别：认证、角色、租户、资源 ID、夹具、数据前缀、
# 清理策略、功能开关、语言和时区。
# 实际变量名登记到 docs/qa/inputs/input-index.md。
